# Used only for local testing of scripts/main.py — in production these are
# stored as GitHub Actions secrets, never committed to the repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used by app/api/alert-settings (the dashboard's alert-mode radio buttons)
# to commit data/alert_settings.json back to GitHub — in production these are
# stored as Vercel project env vars, never committed to the repo.
# Fine-grained PAT scoped to this repo only, with "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Auto-trading (scripts/lib/auto_trader.py + bitkub_trade.py) — real Bitkub
# orders. Create the key at bitkub.com -> API Management, scoped to "Trade"
# permission only (never enable withdrawal on a bot key), and IP-whitelist it
# if you can. In production these are stored as GitHub Actions secrets.
BITKUB_API_KEY=
BITKUB_API_SECRET=

# Auto-trading stays OFF unless this is exactly "1", even with valid Bitkub
# keys above. Test with DRY_RUN=1 first (see step 6 below) before enabling
# for real.
AUTO_TRADE_ENABLED=
AUTO_TRADE_AMOUNT_THB=100
AUTO_TRADE_MAX_POSITIONS=3
AUTO_TRADE_MIN_CONFIDENCE=75
AUTO_TRADE_TAKE_PROFIT_PCT=5
AUTO_TRADE_STOP_LOSS_PCT=8
