# Used only for local testing of scripts/main.py — in production these are
# stored as GitHub Actions secrets, never committed to the repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used by app/api/alert-settings (the dashboard's alert-mode radio buttons)
# to commit data/alert_settings.json back to GitHub — in production these are
# stored as Vercel project env vars, never committed to the repo.
# Fine-grained PAT scoped to this repo only, with "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
